[RefCounted, Tainted] using class nsIPrincipal from "nsIPrincipal.h";

struct PrincipalArgs {
    nsIPrincipal principal;
    uint32_t flags;
};

union PrincipalOrArgs {
    nsIPrincipal;
    PrincipalArgs;
    int;
};

struct LoadArgs {
    nullable nsIPrincipal triggering;
    PrincipalArgs? loading;
    PrincipalArgs[] redirectChain;
    PrincipalOrArgs topLevel;
    [NoTaint=passback] nsIPrincipal loadingPrincipalFromParent;
    nsCString url;
};

struct OnlyPassback {
    [NoTaint=passback] nsIPrincipal principal;
};

[ChildProc=any]
protocol PTaintedFields {
parent:
    async Foo(LoadArgs a, PrincipalArgs[] b, OnlyPassback c);
child:
    async Bar(LoadArgs a);
};
